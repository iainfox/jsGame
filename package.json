{
  "name": "@iainfox/jsgame",
  "version": "0.1.0",
  "description": "A JavaScript library inspired by Pygame, recreating common Pygame functions for drawing and input handling.",
  "type": "module",
  "main": "./dist/jsgame.js",
  "module": "./dist/jsgame.js",
  "exports": {
    ".": {
      "types": "./dist/jsgame.d.ts",
      "import": "./dist/jsgame.js",
      "default": "./dist/jsgame.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:watch": "node scripts/build.mjs --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "pygame",
    "canvas",
    "game",
    "drawing",
    "2d",
    "graphics"
  ],
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.25.12"
  }
}
